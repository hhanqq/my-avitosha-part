-			closedNeeds++
-		}
-	}
-
-	switch closedNeeds {
-	case 3:
-		return model.PetStateEcstatic, nil
-	case 2:
-		return model.PetStateHappy, nil
-	case 1:
-		return model.PetStateContent, nil
-	default:
-		if dailyState.Satiety < LowNeedThreshold {
-			return model.PetStateHungry, nil
-		}
-		if dailyState.Mood < LowNeedThreshold {
