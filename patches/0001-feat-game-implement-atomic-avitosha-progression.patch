+func (manager *gameTestTxManager) WithinTx(ctx context.Context, fn func(context.Context) error) error {
+	if manager.inside {
+		return fn(ctx)
+	}
+	manager.inside = true
+	defer func() { manager.inside = false }()
+	return fn(ctx)
+}
+
+type gameTestPublisher struct {
