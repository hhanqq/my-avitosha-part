+func (repository *gameTestRepository) UnlockRoomItem(_ context.Context, item model.UserRoomItem) (bool, error) {
+	if _, ok := repository.roomItems[item.ItemCode]; ok {
+		return false, nil
+	}
+	repository.roomItems[item.ItemCode] = item
+	return true, nil
