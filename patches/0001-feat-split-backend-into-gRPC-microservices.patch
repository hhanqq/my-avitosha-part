+plugins:
+  - local: protoc-gen-go
+    out: .
+    opt:
+      - module=github.com/guitaramust-sudo/Avitosha/app/backend
+  - local: protoc-gen-go-grpc
+    out: .
+    opt:
+      - module=github.com/guitaramust-sudo/Avitosha/app/backend
diff --git a/app/backend/buf.yaml b/app/backend/buf.yaml
new file mode 100644
index 0000000..8fd9224
--- /dev/null
+++ b/app/backend/buf.yaml
@@ -0,0 +1,15 @@
+version: v2
+modules:
+  - path: api/proto
+lint:
+  use:
+    - STANDARD
+  except:
+    # Transitional JSON read-model envelopes are intentionally reused while
+    # each RPC keeps a distinct method and typed command/request fields.
+    - RPC_REQUEST_RESPONSE_UNIQUE
+    - RPC_REQUEST_STANDARD_NAME
+    - RPC_RESPONSE_STANDARD_NAME
+breaking:
+  use:
+    - FILE
